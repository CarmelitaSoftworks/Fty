diff --git a/.github/workflows/build-custom-apk.yml b/.github/workflows/build-custom-apk.yml
new file mode 100644
index 0000000..1e40ae5
--- /dev/null
+++ b/.github/workflows/build-custom-apk.yml
@@ -0,0 +1,35 @@
+name: "Build NewPipe Custom APK"
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [ master ]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-java@v5
+        with:
+          distribution: 'temurin'
+          java-version: '21'
+          cache: 'gradle'
+
+      # Same signing key on every build, so new APKs install as updates
+      - name: "Install fixed signing key"
+        run: |
+          mkdir -p ~/.android
+          cp signing/debug.keystore ~/.android/debug.keystore
+
+      - name: "Build APK"
+        run: ./gradlew assembleContinuous --stacktrace
+
+      - name: "Upload APK"
+        uses: actions/upload-artifact@v7
+        with:
+          name: NewPipe-Custom
+          path: app/build/outputs/apk/continuous/*.apk
