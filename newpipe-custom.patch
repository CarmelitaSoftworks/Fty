+++ b/app/src/main/java/org/schabi/newpipe/custom/YouTubeAccount.kt
@@ -0,0 +1,101 @@
+package org.schabi.newpipe.custom
+
+import android.app.Activity
+import android.app.PendingIntent
+import android.content.Intent
+import com.google.android.gms.auth.api.identity.AuthorizationRequest
+import com.google.android.gms.auth.api.identity.Identity
+import com.google.android.gms.common.api.Scope
+import io.reactivex.rxjava3.core.Completable
+import io.reactivex.rxjava3.schedulers.Schedulers
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import org.json.JSONObject
+
+/**
+ * Google sign-in through the official YouTube Data API (OAuth). Only an access token is
+ * received; the password never passes through the app.
+ */
+object YouTubeAccount {
+    private const val SCOPE = "https://www.googleapis.com/auth/youtube.force-ssl"
+
+    fun interface Callback<T> {
+        fun onResult(value: T)
+    }
+
+    @JvmStatic
+    fun authorize(
+        activity: Activity,
+        onToken: Callback<String>,
+        onResolution: Callback<PendingIntent>,
+        onError: Callback<Exception>
+    ) {
+        val request = AuthorizationRequest.builder()
+            .setRequestedScopes(listOf(Scope(SCOPE)))
+            .build()
+        Identity.getAuthorizationClient(activity).authorize(request)
+            .addOnSuccessListener { result ->
+                val pendingIntent = result.pendingIntent
+                val token = result.accessToken
+                if (result.hasResolution() && pendingIntent != null) {
+                    onResolution.onResult(pendingIntent)
+                } else if (token != null) {
+                    onToken.onResult(token)
+                } else {
+                    onError.onResult(IllegalStateException("No access token"))
+                }
+            }
+            .addOnFailureListener { e -> onError.onResult(e) }
+    }
+
+    @JvmStatic
+    fun tokenFromIntent(activity: Activity, data: Intent?): String? {
+        if (data == null) return null
+        return try {
+            Identity.getAuthorizationClient(activity)
+                .getAuthorizationResultFromIntent(data).accessToken
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    @JvmStatic
+    fun postComment(token: String, videoId: String, text: String): Completable =
+        Completable.fromAction {
+            val body = JSONObject().put(
+                "snippet",
+                JSONObject()
+                    .put("videoId", videoId)
+                    .put(
+                        "topLevelComment",
+                        JSONObject().put("snippet", JSONObject().put("textOriginal", text))
+                    )
+            ).toString()
+            val connection = URL(
+                "https://www.googleapis.com/youtube/v3/commentThreads?part=snippet"
+            ).openConnection() as HttpURLConnection
+            try {
+                connection.requestMethod = "POST"
+                connection.doOutput = true
+                connection.connectTimeout = 10000
+                connection.readTimeout = 10000
+                connection.setRequestProperty("Authorization", "Bearer $token")
+                connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8")
+                connection.outputStream.use { it.write(body.toByteArray()) }
+                val code = connection.responseCode
+                if (code !in 200..299) {
+                    val error = connection.errorStream?.bufferedReader()?.use { it.readText() }
+                    throw IOException("YouTube ($code): " + parseError(error))
+                }
+            } finally {
+                connection.disconnect()
+            }
+        }.subscribeOn(Schedulers.io())
+
+    private fun parseError(body: String?): String = try {
+        JSONObject(body ?: "").getJSONObject("error").getString("message")
+    } catch (e: Exception) {
+        body?.take(200) ?: "unknown error"
+    }
+}
