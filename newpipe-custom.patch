@@ -0,0 +1,137 @@
+package org.schabi.newpipe.custom
+
+import android.content.Context
+import android.view.View
+import android.widget.ImageView
+import androidx.preference.PreferenceManager
+import io.reactivex.rxjava3.core.Single
+import io.reactivex.rxjava3.schedulers.Schedulers
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.security.MessageDigest
+import java.util.concurrent.ConcurrentHashMap
+import org.json.JSONArray
+import org.json.JSONObject
+import org.schabi.newpipe.NewPipeDatabase
+import org.schabi.newpipe.R
+import org.schabi.newpipe.extractor.Image
+import org.schabi.newpipe.util.image.CoilHelper
+
+/**
+ * Extras of "NewPipe Custom": channel avatars in lists, Return YouTube Dislike and SponsorBlock.
+ */
+object CustomFeatures {
+    private const val SPONSORBLOCK_KEY = "custom_sponsorblock"
+    private const val RYD_KEY = "custom_return_dislike"
+    private const val USER_AGENT = "NewPipeCustom/1.0"
+
+    // ---------------- Channel avatars ----------------
+    private val avatars = ConcurrentHashMap<String, String>()
+
+    @Volatile
+    private var avatarLoadStarted = false
+
+    private fun ensureAvatarCache(context: Context) {
+        if (avatarLoadStarted) return
+        avatarLoadStarted = true
+        NewPipeDatabase.getInstance(context.applicationContext).subscriptionDAO().getAll()
+            .subscribeOn(Schedulers.io())
+            .subscribe({ list ->
+                for (sub in list) {
+                    val url = sub.url
+                    val avatar = sub.avatarUrl
+                    if (url != null && avatar != null) {
+                        avatars[url] = avatar
+                    }
+                }
+            }, { avatarLoadStarted = false })
+    }
+
+    /** Shows the uploader avatar next to the title, if the layout has a place for it. */
+    @JvmStatic
+    fun bindUploaderAvatar(root: View, images: List<Image>?, uploaderUrl: String?) {
+        val avatarView = root.findViewById<ImageView>(R.id.itemUploaderAvatarView) ?: return
+        ensureAvatarCache(root.context)
+        if (!images.isNullOrEmpty()) {
+            avatarView.visibility = View.VISIBLE
+            CoilHelper.loadAvatar(avatarView, images)
+            return
+        }
+        val cached = uploaderUrl?.let { avatars[it] }
+        if (cached != null) {
+            avatarView.visibility = View.VISIBLE
+            CoilHelper.loadAvatar(avatarView, cached)
+        } else {
+            avatarView.visibility = View.GONE
+        }
+    }
+
+    // ---------------- Settings ----------------
+    @JvmStatic
+    fun isSponsorBlockEnabled(context: Context): Boolean =
+        PreferenceManager.getDefaultSharedPreferences(context).getBoolean(SPONSORBLOCK_KEY, true)
+
+    @JvmStatic
+    fun isReturnDislikeEnabled(context: Context): Boolean =
+        PreferenceManager.getDefaultSharedPreferences(context).getBoolean(RYD_KEY, true)
+
+    private fun httpGet(url: String): String? {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        connection.connectTimeout = 7000
+        connection.readTimeout = 7000
+        connection.setRequestProperty("User-Agent", USER_AGENT)
+        return try {
+            if (connection.responseCode != 200) null
+            else connection.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    // ---------------- Return YouTube Dislike ----------------
+    @JvmStatic
+    fun fetchDislikes(videoId: String): Single<Long> = Single.fromCallable {
+        val body = httpGet(
+            "https://returnyoutubedislikeapi.com/votes?videoId=" +
+                URLEncoder.encode(videoId, "UTF-8")
+        ) ?: throw IllegalStateException("No dislike data")
+        JSONObject(body).getLong("dislikes")
+    }.subscribeOn(Schedulers.io())
+
+    // ---------------- SponsorBlock ----------------
+    private fun sha256Hex(text: String): String =
+        MessageDigest.getInstance("SHA-256").digest(text.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+
+    /**
+     * Segments to skip, as [startMillis, endMillis]. Uses the hash-prefix API, so the
+     * exact video being watched is not sent to the SponsorBlock server.
+     */
+    @JvmStatic
+    fun fetchSponsorSegments(videoId: String): Single<List<LongArray>> = Single.fromCallable {
+        val categories = URLEncoder.encode(
+            "[\"sponsor\",\"selfpromo\",\"interaction\"]", "UTF-8"
+        )
+        val body = httpGet(
+            "https://sponsor.ajay.app/api/skipSegments/" + sha256Hex(videoId).substring(0, 4) +
+                "?categories=" + categories + "&actionType=skip"
+        ) ?: return@fromCallable emptyList<LongArray>()
+
+        val result = ArrayList<LongArray>()
+        val videos = JSONArray(body)
+        for (i in 0 until videos.length()) {
+            val video = videos.getJSONObject(i)
+            if (video.optString("videoID") != videoId) continue
+            val segments = video.optJSONArray("segments") ?: continue
+            for (j in 0 until segments.length()) {
+                val range = segments.getJSONObject(j).optJSONArray("segment") ?: continue
+                val start = (range.getDouble(0) * 1000).toLong()
+                val end = (range.getDouble(1) * 1000).toLong()
+                if (end - start > 1000) result.add(longArrayOf(start, end))
+            }
+        }
+        result.sortBy { it[0] }
+        result as List<LongArray>
+    }.subscribeOn(Schedulers.io())
+}
diff --git a/app/src/main/java/org/schabi/newpipe/custom/YouTubeAccount.kt b/app/src/main/java/org/schabi/newpipe/custom/YouTubeAccount.kt
new file mode 100644
